# Password untuk halaman /admin (WAJIB diganti)
ADMIN_PASSWORD=ganti-dengan-password-kuat

# Database Upstash Redis (otomatis terisi jika pakai integrasi Upstash di Vercel Marketplace).
# Jika kosong, aplikasi memakai penyimpanan in-memory (hanya untuk uji lokal — data hilang saat restart).
KV_REST_API_URL=
KV_REST_API_TOKEN=
